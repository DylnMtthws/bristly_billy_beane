# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Non-secret configuration does NOT belong here — it lives in config/*.yaml.
# This file holds credentials and per-deployment endpoints only.

# --- Web app ---------------------------------------------------------------

# Signs session cookies and CSRF tokens. REQUIRED in production: without it the
# app generates a random key at startup and every restart logs everyone out.
#   python -c "import secrets; print(secrets.token_hex(32))"
SABER_SECRET_KEY=

# How users authenticate (ADR-026):
#   tailscale  identity from the `tailscale serve` proxy headers. No passwords,
#              no invite links, no login form. Private tailnet deployment.
#   hybrid     both: tailnet identity when present, password form otherwise.
#              Required for a public Tailscale Funnel deployment, because
#              Funnel traffic is anonymous.
#   password   email + argon2id with invite links only. The default, for local
#              development and the test suite.
# See docs/deployment.md.
SABER_AUTH_MODE=password

# Set to 1 when the app is reachable from the internet (Tailscale Funnel).
# Makes SABER_SECRET_KEY mandatory and enables HSTS. Does not change routing.
# SABER_PUBLIC=0

# Set to 0 only for local http previews. In tailscale mode the proxy terminates
# HTTPS on the tailnet, so this must stay on.
# SABER_COOKIE_SECURE=1

# --- cEDH Deck Lab ---------------------------------------------------------

# Card and tournament facts from the ingestion pipeline's public contract.
# MUST be the mtg_consumer role: it has USAGE on mtg_v1 and no grant at all on
# mtg_internal, so a query that reaches past the contract fails immediately.
# Unset => the lab runs on the checked-in fixture corpus and says so on every
# page it renders.
# MTG_V1_DSN=postgresql://mtg_consumer:PASSWORD@localhost:5432/mtg

# Credential for the cEDH model gateway (Hugging Face router -> DeepInfra).
# Unset => decks still build; there is no narrative. The deck is deterministic,
# so running with no model is a supported mode, not a broken one.
# HF_TOKEN=hf_...

# Per-deployment model overrides. These beat config/cedh.yaml, so a staging box
# can point at a different model without editing a file that is in git.
# CEDH_MODEL_BASE_URL=https://router.huggingface.co/v1
# CEDH_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash:deepinfra
# CEDH_MODEL_PROVIDER=deepinfra

# The commander_simulator binary, for `simulator.mode: subprocess` in
# config/cedh.yaml and for `pytest -m simulator`.
# CEDH_SIMULATOR_BIN=/Users/you/Projects/commander_simulator/build/release/src/cli/cs

# --- Legacy casual generator ----------------------------------------------

# Required by the original Commander generator only. The cEDH path does not
# use Anthropic and does not import its SDK.
# ANTHROPIC_API_KEY=sk-ant-...
