# Copy to .env and fill in. .env is gitignored.

# --- Required ---

# Anthropic API key (deck generation / profile synthesis).
ANTHROPIC_API_KEY=sk-ant-...

# Flask session/CSRF signing key. MUST be set in production (a random fallback
# is used otherwise, and sessions won't survive a restart). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SABER_SECRET_KEY=

# --- Optional ---

# Session cookies default to Secure (HTTPS-only), which is correct behind the
# Cloudflare Tunnel. Set to 0 ONLY for local http previews so the cookie is sent.
# SABER_COOKIE_SECURE=1
